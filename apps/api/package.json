{
  "name": "@tallynest/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src e2e",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.mts",
    "auth:generate": "auth generate --config src/auth/auth.cli.ts --output ../../packages/db/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@react-pdf/renderer": "4.9.0",
    "@sentry/nestjs": "11.2.0",
    "@tallynest/contracts": "workspace:*",
    "@tallynest/db": "workspace:*",
    "@tallynest/domain": "workspace:*",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "better-auth": "1.7.10",
    "express": "5.2.1",
    "nodemailer": "10.1.1",
    "react": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@tallynest/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/supertest": "7.2.1",
    "auth": "1.7.10",
    "eslint": "9.39.5",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
