# Copy to /opt/tallynest/.env on the droplet and fill in. chmod 600.
DOMAIN=app.example.com

# ghcr.io/<lowercase GitHub owner>/tallynest. deploy.sh manages IMAGE_TAG.
IMAGE_PREFIX=ghcr.io/owner/tallynest
IMAGE_TAG=latest

# URL-safe values only; generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# Production SMTP provider, e.g. smtps://user:password@smtp.provider.com:465
SMTP_URL=
MAIL_FROM=TallyNest <no-reply@example.com>
