# Copy to /opt/billsafi/.env on the droplet and fill in. chmod 600.
DOMAIN=account.billsafi.com
LANDING_DOMAIN=billsafi.com

# ghcr.io/<lowercase GitHub owner>/billsafi. deploy.sh manages IMAGE_TAG.
IMAGE_PREFIX=ghcr.io/<owner>/billsafi
IMAGE_TAG=latest

# URL-safe values only; generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# Google sign-in (D055). Leave both blank to hide "Continue with Google".
# Redirect URI to register in Google Cloud: https://<DOMAIN>/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# User IDs allowed into the read-only /admin dashboard (D057), comma separated.
# Leave blank to turn admin off.
# Emails are not verified, so admin is allowed by user ID, not email. Find yours with:
#   docker compose exec postgres psql -U billsafi -d billsafi -c "select id, email from users where email = 'you@example.com';"
ADMIN_USER_IDS=

# Optional links on the admin System Health page (D065). Each must be an https URL;
# leave blank to hide its card.
ADMIN_SENTRY_URL=
ADMIN_UPTIME_URL=

# Resend HTTPS API (outbound SMTP ports are blocked on DigitalOcean).
# Verify your sender domain in Resend.
RESEND_API_KEY=
MAIL_FROM=BillSafi <no-reply@billsafi.com>

# Password reset links last this many seconds. Leave blank for one hour.
RESET_TOKEN_TTL_SECONDS=

# Check-in emails to quiet accounts (D069). Keep off until you are ready to email
# real people. When on, REENGAGEMENT_REPLY_TO must be an inbox someone reads,
# because the last email asks for a reply. The signature signs that email.
REENGAGEMENT_JOBS=on
REENGAGEMENT_DAILY_LIMIT=40
REENGAGEMENT_REPLY_TO=mawirab@billsafi.com
REENGAGEMENT_SIGNATURE=

# Background jobs inside the API. Leave on; switch off only to pause them.
# BILLING_JOBS: payment checks and renewal reminders.
# MAINTENANCE_JOBS: daily clean-up of records past retention (D066).
BILLING_JOBS=on
MAINTENANCE_JOBS=on

# M-Pesa Paybill billing (D051). Leave MPESA_ENV=disabled until Safaricom
# approves the Paybill, then set production and fill in the Daraja app keys.
MPESA_ENV=disabled
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Generate with: openssl rand -hex 24
MPESA_CALLBACK_TOKEN=

# Plan prices are in USD and charged in KES. Leave blank to use the daily
# published rate, or pin one (for example 129.50) if that source is down.
USD_KES_RATE=

# Sentry error reporting (D052). Leave blank to turn it off. The browser DSN
# is set as the SENTRY_WEB_DSN repository variable in GitHub, because it is
# compiled into the web image.
SENTRY_API_DSN=
SENTRY_WEB_DSN=
