# Copy to /opt/tallynest/.env on the droplet and fill in. chmod 600.
DOMAIN=app.example.com

# ghcr.io/<lowercase GitHub owner>/tallynest. deploy.sh manages IMAGE_TAG.
IMAGE_PREFIX=ghcr.io/owner/tallynest
IMAGE_TAG=latest

# URL-safe values only; generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# Production SMTP provider, e.g. smtps://user:password@smtp.provider.com:465
SMTP_URL=
MAIL_FROM=TallyNest <no-reply@example.com>

# M-Pesa Paybill billing (D051). Leave MPESA_ENV=disabled until Safaricom
# approves the Paybill, then set production and fill in the Daraja app keys.
MPESA_ENV=disabled
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Generate with: openssl rand -hex 24
MPESA_CALLBACK_TOKEN=

# Sentry error reporting (D052). Leave blank to turn it off. The browser DSN
# is set as the SENTRY_WEB_DSN repository variable in GitHub, because it is
# compiled into the web image.
SENTRY_API_DSN=
SENTRY_WEB_DSN=
