# Local development defaults. Copy to .env and adjust.
DATABASE_URL=postgres://billsafi:billsafi@localhost:5434/billsafi

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Optional web-only runtime origins. Leave both blank for local single-host routing.
# Production Compose derives these from DOMAIN and LANDING_DOMAIN.
APP_ORIGIN=
MARKETING_ORIGIN=

# production | staging | development
NEXT_PUBLIC_APP_ENV=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
RESET_TOKEN_TTL_SECONDS=3600

# Google sign-in (D055). Leave both blank to hide "Continue with Google".
# Create a "Web application" OAuth client in Google Cloud Console and add
# <WEB_ORIGIN>/api/v1/auth/callback/google as an authorized redirect URI,
# for example http://localhost:3000/api/v1/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# User IDs allowed into the read-only /admin dashboard, comma separated.
# Leave blank to turn admin off.
# Find yours with:
#   select id, email from users where email = 'you@example.com';
ADMIN_USER_IDS=

# Optional links on the admin System Health page (D065). Each must be an https URL;
# leave blank to hide its card. The page links out because Sentry and your uptime
# monitor hold the real error rates and availability.
# Your Sentry project or issues page:
ADMIN_SENTRY_URL=
# Your uptime monitor's status or dashboard page:
ADMIN_UPTIME_URL=

SMTP_URL=smtp://localhost:1025
MAIL_FROM=BillSafi <no-reply@billsafi.local>

# Web: server-side address of the API (browser requests go through the /api rewrite)
API_INTERNAL_URL=http://localhost:4000

# M-Pesa subscription billing (D051). "fake" needs no keys: a payment request
# succeeds after about 5 seconds, or fails when the phone ends in 0000.
# For the Daraja sandbox: create an app at developer.safaricom.co.ke, set
# MPESA_ENV=sandbox, use shortcode 174379 and the sandbox passkey, and expose
# the API with a tunnel (cloudflared tunnel --url http://localhost:4000).
MPESA_ENV=fake
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public HTTPS origin of the API, such as the tunnel URL; no trailing path.
MPESA_CALLBACK_URL=
# Generate with: openssl rand -hex 24
MPESA_CALLBACK_TOKEN=
# Renewal reminders and late-payment checks run inside the API.
BILLING_JOBS=on
# Daily clean-up of recorded product events, failures, job runs and backup runs
# past their retention (D066). Switch off to keep everything.
MAINTENANCE_JOBS=on

# Plan prices are in USD and charged in KES. Leave blank to use the daily
# published rate, or pin one (for example 129.50).
USD_KES_RATE=

# Sentry error reporting (D052). Leave blank to keep it off locally.
# SENTRY_DSN is read by the API and the web server at runtime;
# NEXT_PUBLIC_SENTRY_DSN is compiled into the browser bundle at build time.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
