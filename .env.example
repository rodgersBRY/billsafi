# Local development defaults. Copy to .env and adjust.
DATABASE_URL=postgres://tallynest:tallynest@localhost:5434/tallynest

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
RESET_TOKEN_TTL_SECONDS=3600

SMTP_URL=smtp://localhost:1025
MAIL_FROM=TallyNest <no-reply@tallynest.local>

# Web: server-side address of the API (browser requests go through the /api rewrite)
API_INTERNAL_URL=http://localhost:4000

# M-Pesa subscription billing (D051). "fake" needs no keys: a payment request
# succeeds after about 5 seconds, or fails when the phone ends in 0000.
# For the Daraja sandbox: create an app at developer.safaricom.co.ke, set
# MPESA_ENV=sandbox, use shortcode 174379 and the sandbox passkey, and expose
# the API with a tunnel (cloudflared tunnel --url http://localhost:4000).
MPESA_ENV=fake
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public HTTPS origin of the API, such as the tunnel URL; no trailing path.
MPESA_CALLBACK_URL=
# Generate with: openssl rand -hex 24
MPESA_CALLBACK_TOKEN=
# Renewal reminders and late-payment checks run inside the API.
BILLING_JOBS=on
